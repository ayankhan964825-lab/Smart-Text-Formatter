731799"/></a:lnTo><a:lnTo><a:pt x="0" y="0"/></a:lnTo><a:close/></a:path></a:pathLst></a:custGeom><a:blipFill><a:blip r:embed="rId5"><a:extLst><a:ext uri="{96DAC541-7B7A-43D3-8B79-37D633B846F1}"><asvg:svgBlip r:embed="rId6" xmlns:asvg="http://schemas.microsoft.com/office/drawing/2016/SVG/main"/></a:ext></a:extLst></a:blip><a:stretch><a:fillRect l="0" t="0" r="0" b="0"/></a:stretch></a:blipFill></p:spPr></p:sp><p:sp><p:nvSpPr><p:cNvPr name="TextBox 6" id="6"/><p:cNvSpPr txBox="true"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm rot="0"><a:off x="1028700" y="3205160"/><a:ext cx="16230600" cy="1729048"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr anchor="t" rtlCol="false" tIns="0" lIns="0" bIns="0" rIns="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="ctr"><a:lnSpc><a:spcPts val="3441"/></a:lnSpc><a:spcBef><a:spcPct val="0"/></a:spcBef></a:pPr><a:r><a:rPr lang="en-US" b="true" sz="2458"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:latin typeface="Public Sans Bold"/><a:ea typeface="Public Sans Bold"/><a:cs typeface="Public Sans Bold"/><a:sym typeface="Public Sans Bold"/></a:rPr><a:t>Despite possessing a vast and accomplished global alumni network, the institution currently faces a significant engagement gap in its mentorship and startup incubation programs. While alumni express a high degree of brand loyalty, this sentiment has not translated into a consistent, structured contribution toward the entrepreneurial ecosystem.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr name="TextBox 7" id="7"/><p:cNvSpPr txBox="true"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm rot="0"><a:off x="117417" y="5615240"/><a:ext cx="17728599" cy="941070"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr anchor="t" rtlCol="false" tIns="0" lIns="0" bIns="0" rIns="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="l" marL="582927" indent="-291463" lvl="1"><a:lnSpc><a:spcPts val="3779"/></a:lnSpc><a:buFont typeface="Arial"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="true" sz="2699"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:latin typeface="Cormorant Garamond Bold"/><a:ea typeface="Cormorant Garamond Bold"/><a:cs typeface="Cormorant Garamond Bold"/><a:sym typeface="Cormorant Garamond Bold"/></a:rPr><a:t>Fragmented Engagement Channels: There is a lack of a streamlined, digital-first platform to match alumni expertise with the specific needs of student-led startups. This friction makes the barrier to entry for busy professionals unnecessarily high.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr name="TextBox 8" id="8"/><p:cNvSpPr txBox="true"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm rot="0"><a:off x="117417" y="7232585"/><a:ext cx="17728599" cy="976675"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr anchor="t" rtlCol="false" tIns="0" lIns="0" bIns="0" rIns="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="l" marL="604516" indent="-302258" lvl="1"><a:lnSpc><a:spcPts val="3919"/></a:lnSpc><a:buFont typeface="Arial"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="true" sz="2799"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:latin typeface="Cormorant Garamond Bold"/><a:ea typeface="Cormorant Garamond Bold"/><a:cs typeface="Cormorant Garamond Bold"/><a:sym typeface="Cormorant Garamond Bold"/></a:rPr><a:t>Missing Incentives: Many alumni view mentoring as "charity" work instead of a professional partnership. Without formal recognition or a way to benefit from the startups they help, it is difficult to keep them engaged.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr name="TextBox 9" id="9"/><p:cNvSpPr txBox="true"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm rot="0"><a:off x="0" y="8696436"/><a:ext cx="17728599" cy="976675"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr anchor="t" rtlCol="false" tIns="0" lIns="0" bIns="0" rIns="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="l" marL="604516" indent="-302258" lvl="1"><a:lnSpc><a:spcPts val="3919"/></a:lnSpc><a:buFont typeface="Arial"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="true" sz="2799"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:latin typeface="Cormorant Garamond Bold"/><a:ea typeface="Cormorant Garamond Bold"/><a:cs typeface="Cormorant Garamond Bold"/><a:sym typeface="Cormorant Garamond Bold"/></a:rPr><a:t>Inefficient Matching Mechanisms: Current efforts often fail to align the specific technical or domain expertise of an alumnus with the relevant niche of a startup, leading to low-impact engagements and high dropout rates.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>