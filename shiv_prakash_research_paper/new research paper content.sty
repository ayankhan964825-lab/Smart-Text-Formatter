db_path = os.path.join(BASE_DIR, 'inventory.db')
# create logs folder if not exists
os.makedirs(log_dir, exist_ok=True)
# -------------------- LOGGING --------------------
logging.basicConfig(
    filename=os.path.join(log_dir, "ingestion_db.log"),
    level=logging.DEBUG,
    format="%(asctime)s - %(levelname)s - %(message)s",
    filemode="a"
)
# -------------------- DATABASE --------------------
engine = create_engine(f'sqlite:///{db_path}')
# -------------------- FUNCTIONS --------------------
def ingest_db(df, table_name, engine):
    """Ingest dataframe into database table"""
    df.to_sql(table_name, con=engine, if_exists='replace', index=False)
def load_raw_data():
    """Load CSVs in chunks and ingest into database safely"""
    if not os.path.exists(data_path):
        logging.error(f"Data folder not found: {data_path}")
        print("Data folder not found!")
        return
    start = time.time()
    for file in os.listdir(data_path):
        if file.endswith('.csv'):
            try:
                file_path = os.path.join(data_path, file)
                table_name = file[:-4].lower()
                logging.info(f'Ingesting {file} into table {table_name}')
                print(f"\nProcessing: {file}")
                chunk_iter = pd.read_csv(file_path, chunksize=100000)
                for i, chunk in enumerate(chunk_iter):
                    chunk.to_sql(
                        table_name,
                        con=engine,
                        if_exists='append',   # IMPORTANT: append for chunks
                        index=False
                    )
                    print(f"Chunk {i+1} loaded")
                    # free memory
                    del chunk
                    gc.collect()
                print(f"Completed: {file}")
            except Exception as e:
                logging.error(f"Error processing {file}: {e}")
                print(f"Error with {file}: {e}")
    end = time.time()
    total_time = (end - start) / 60
    logging.info('-------------- Ingestion Complete ------------')
    logging.info(f'Total Time Taken: {total_time:.2f} minutes')
    print(f"\nIngestion completed in {total_time:.2f} minutes")
# -------------------- MAIN --------------------
if __name__ == '__main__':
    load_raw_data()
 
 
 
 
 
 
